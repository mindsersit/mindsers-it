{{!< default}}

{{#contentFor 'htmlLang'}}{{@site.locale}}{{/contentFor}}

{{#contentFor 'styles'}}
<link rel="stylesheet" type="text/css" href="{{asset "css/home.css"}}" />
{{/contentFor}}

{{#contentFor 'title'}}{{meta_title}} - Le studio qui transforme ton idée en SaaS en 1 mois seulement !{{/contentFor}}

<div class="mds-home">
    <header class="mds-header">
        <div class="mds-container">
            <div class="presentation">
                <h1 class="mds-title">Vous avez une idée de SaaS. On vous aide à la lancer.</h1>
                <p>
                    Landing page de validation, MVP ou produit complet : on intervient à chaque étape, comme une vraie équipe produit externalisée.
                </p>

                <div class="mds-cta">
                    <p>
                        <a href="#offres" class="button primary">Découvrir nos offres</a>
                    </p>
                    <p class='rate'>
                        <span class='stars'>&starf;&starf;&starf;&starf;&starf;</span>
                        <span>
                            +{{@custom.amout_of_project_done }} projets SaaS accompagnés !
                        </span>
                    </p>
                </div>

                <div class="offer-links">
                    <a href="/studio-saas/landing-page/" class="offer-link">→ Valider une idée</a>
                    <a href="/studio-saas/mvp/" class="offer-link">→ Lancer un MVP</a>
                    <a href="/studio-saas/saas/" class="offer-link">→ Construire un SaaS complet</a>
                </div>
            </div>
        </div>
    </header>

    {{> "ui/customer-logos"}}

    <section class="mds-section mds-personas accent">
        <div class="mds-container">
            <div class="section-type">Pour qui ?</div>
            <h2 class="section-title">
                Que vous soyez au stade de l’idée ou prêt à scaler,<br />
                notre studio vous accompagne.
            </h2>

            <div class="persona-cards">
                <div class="persona-card">
                    <h3>J’ai une idée, mais pas encore de produit</h3>
                    <p>Vous voulez tester l’intérêt du marché sans tout développer ? On vous aide à valider votre idée en 2 semaines avec une landing page optimisée.</p>
                    <a href="/studio-saas/landing-page/" class="button primary">Voir l’offre Validation</a>
                </div>

                <div class="persona-card">
                    <h3>Mon idée est validée, je veux un MVP rapide</h3>
                    <p>Vous avez parlé à des users, défini votre feature clé et souhaitez confronter l’idée à la réalité terrain ? On construit votre MVP, prêt à vendre, en 1 mois.</p>
                    <a href="/studio-saas/mvp/" class="button primary">Voir l’offre MVP</a>
                </div>

                <div class="persona-card">
                    <h3>J’ai une vision claire, je veux lancer mon SaaS</h3>
                    <p>Vous avez besoin d’une équipe complète pour designer, coder, marketer et lancer votre SaaS clé-en-main ? On s’occupe de tout.</p>
                    <a href="/studio-saas/saas/" class="button primary">Voir l’offre SaaS complet</a>
                </div>
            </div>
        </div>
    </section>

    <section id="offres" class="mds-section offer-section">
        <div class="mds-container">
            <div class="section-type">Nos offres</div>
            <h2 class="section-title">
                Trois offres pour trois étapes clés dans la vie de votre SaaS
            </h2>
            <p>Pas sûr de l’offre qu’il vous faut ? Si vous avez une idée à tester, commencez par une landing page. Si vous voulez un prototype fonctionnel, prenez le MVP. Et si vous êtes prêt à scaler, partez sur l’offre SaaS clé en main.</p>
            <div class="pricing-options">
                <div class="pricing-option">
                    <div class="body">
                        <h3>Pack "Validation"</h3>
                        <p>Testez rapidement l'intérêt du marché pour votre idée de SaaS avant même de commencer le développement.</p>
                        <p class="price">{{@custom.price_of_landing_page }}€ HT</p>
                    </div>
                    <a href="/studio-saas/landing-page/" class="button primary">Voir en détail</a>
                </div>
                <div class="pricing-option">
                    <div class="body">
                        <h3>Pack "MVP"</h3>
                        <p>Obtenez une version minimale viable de votre SaaS mono-feature en seulement 1 mois pour confronter votre idée au marché.</p>
                        <p class="price">{{@custom.price_of_mvp }}€ HT</p>
                    </div>
                    <a href="/studio-saas/mvp/" class="button primary">Voir en détail</a>
                </div>
                <div class="pricing-option">
                    <div class="body">
                        <h3>Offre "SaaS clé-en-main"</h3>
                        <p>Une solution complète incluant conception, développement, design graphique, déploiement et marketing.</p>
                        <p class="price">25 000€ HT / mois</p>
                        <p class="price-mentions">Minimum deux mois d'accompagnement</p>
                    </div>
                    <a href="/studio-saas/saas/" class="button primary">Voir en détail</a>
                </div>
            </div>
            <p>Vous ne trouvez pas le pack qui vous correspond ? <a href="{{@custom.global_cta_url}}">Contactez-nous</a> pour une solution sur mesure adaptée à vos besoins spécifiques.</p>
        </div>
    </section>

    {{> "ui/method"}}

    {{> "ui/testimonial" dark="true"}}

    {{> "ui/team"}}

    <section class="faq-section mds-section">
        <div class="mds-container">
            <div class="section-type">FAQ</div>
            <h2 class="section-title">
                Questions fréquentes sur notre studio SaaS
            </h2>

            <div class="faq-items">
                <div class="faq-item">
                    <input type="checkbox" id="faq1" class="faq-toggle" />
                    <h3><label for="faq1">Quelle est la différence entre vos trois offres ?</label></h3>
                    <p>Notre offre "Validation" vous aide à tester une idée. L’offre "MVP" permet de créer un premier produit vendable. L’offre "SaaS complet" est idéale si vous êtes prêt à passer à l’échelle avec un vrai produit complet.</p>
                </div>

                <div class="faq-item">
                    <input type="checkbox" id="faq2" class="faq-toggle" />
                    <h3><label for="faq2">Comment savoir si je suis prêt à vous confier mon projet ?</label></h3>
                    <p>Si vous avez une idée claire et un minimum de retours utilisateurs, c’est suffisant. Le reste, on vous aide à le structurer.</p>
                </div>

                <div class="faq-item">
                    <input type="checkbox" id="faq3" class="faq-toggle" />
                    <h3><label for="faq3">Est-ce que vous pouvez m’aider à lever des fonds ?</label></h3>
                    <p>On ne fait pas de levée, mais on vous aide à construire un produit ou MVP qui impressionne investisseurs ou banquiers. Plusieurs projets accompagnés ont levé après livraison.</p>
                </div>

                <div class="faq-item">
                    <input type="checkbox" id="faq4" class="faq-toggle" />
                    <h3><label for="faq4">Est-ce que vous travaillez aussi avec des freelances ou agences ?</label></h3>
                    <p>Oui, régulièrement. On intervient comme extension produit / tech pour des agences débordées ou des freelances non techniques.</p>
                </div>

                <div class="faq-item">
                    <input type="checkbox" id="faq5" class="faq-toggle" />
                    <h3><label for="faq5">Et si je ne suis pas satisfait du résultat ?</label></h3>
                    <p>On livre par itérations avec retours constants. Vous validez chaque étape. Pas de surprise, pas de livrable “jeté en prod sans votre accord”.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="mds-cta-end">
        {{#if @custom.global_cta_url}}
        <div class="mds-cta">
            <h2>On transforme votre idée en produit réel.<br/>
      Prêt à commencer ?</h2>
            <p>
                Que vous soyez au stade de l’idée ou prêt à scaler,<br />
                on a une offre pensée pour vous.
            </p>
            <p>
                <a href="{{@custom.global_cta_url}}" class="button highlighted">{{@custom.global_cta_text}}</a>
            </p>
            <p class='rate'>
                <span class='stars'>&starf;&starf;&starf;&starf;&starf;</span>
                <span>
                    +{{@custom.amout_of_project_done }} SaaS réalisés avec succès !
                </span>
            </p>
        </div>
        {{/if}}
    </section>
</div>