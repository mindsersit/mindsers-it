{{!< default}}

{{#contentFor 'htmlLang'}}{{@site.locale}}{{/contentFor}}

{{#contentFor 'activityClass'}}mds-talent{{/contentFor}}

{{#contentFor 'styles'}}
<link rel="stylesheet" type="text/css" href="{{asset "css/landing.css"}}" />
{{/contentFor}}

{{#contentFor 'title'}}MindsersIT Talent – Freelances tech recommandés par notre studio{{/contentFor}}

<div class="mds-home mds-landing-page mds-talent">
    <header class="mds-header">
        <div class="mds-container">
            <div class="presentation">
                <h1 class="mds-title" style="text-align: center;">
                    Arrêtez de perdre du temps à chercher les bons freelances tech.
                    Travaillez enfin avec les meilleurs.
                </h1>
                <p>
                    Fini les intermédiaires (agences, ESN, etc.), les mauvais profils et les déceptions. Nos talents ont déjà fait leurs preuves sur +{{@custom.amount_of_freelancers_recommended}} missions.<br/>
                    <strong>Développeurs senior, designers experts, product builders confirmés.</strong><br/>
                    Démarrage immédiat, résultats garantis.
                </p>

                <div class="mds-cta">
                    <p>
                        <a href="{{@custom.global_cta_url}}" class="button primary">Accéder aux meilleurs talents</a>
                    </p>
                    <p class='rate'>
                        <span class='stars'>&starf;&starf;&starf;&starf;&starf;</span>
                        <span>
                            +{{@custom.amount_of_freelancers_recommended }} missions réussies avec nos talents freelance !
                        </span>
                    </p>
                </div>
            </div>
        </div>
    </header>

    {{> "ui/customer-logos"}}

    <section class="mds-section mds-why accent">
        <div class="mds-container">
            <div class="section-type">Pourquoi cette offre ?</div>
            <h2 class="section-title">
                Pas envie d’une agence ?<br/>
                Mais pas envie de galérer non plus.
            </h2>
            <p>
                Chez MindsersIT, on conçoit et développe des SaaS et des sites e-commerce. On connaît bien le problème :<br/>
                quand on veut bosser vite et bien, il faut les bonnes personnes… mais les bons freelances sont durs à trouver.
            </p>
            <p>Alors on a lancé <strong>MindsersIT Talent</strong> : une offre simple, directe, pour <strong>travailler avec les meilleurs profils tech</strong>, sans passer par une agence.</p>
            <div class="versus">
                <p>
                    Vos freelances <strong>avant</strong> MindsersIT Talent :<br/><br/>
                    ❌ Disparaissent en cours de projet<br/>
                    ❌ Livrent du code de mauvaise qualité<br/>
                    ❌ Ne respectent pas les délais<br/>
                    ❌ Surestiment leurs compétences
                </p>
                <p>
                    <strong>Avec</strong> MindsersIT Talent :<br/><br/>
                    ✅ <strong>Que des talents validés sur le terrain</strong><br/>
                    ✅ <strong>Zéro intermédiaire, zéro commission cachée</strong><br/>
                    ✅ <strong>Démarrage en 48h maximum</strong>
                </p>
            </div>
        </div>
    </section>

    <section class="mds-section mds-process">
        <div class="mds-container">
            <div class="section-type">Notre fonctionnement</div>
            <h2 class="section-title">
                De votre problème à votre solution :<br/>
                3 étapes, 48h maximum
            </h2>
            <div class="steps">
                <div class="step">
                    <div class="body">
                        <h3>1. Vous nous briefez en 15 minutes</h3>
                        <p>
                            Un appel rapide pour comprendre votre besoin urgent, vos contraintes techniques et votre deadline. On prend le relais immédiatement.
                        </p>
                    </div>
                </div>
                <div class="step">
                    <div class="body">
                        <h3>2. On sélectionne LE bon profil pour vous</h3>
                        <p>
                            Maximum 3 talents triés sur le volet. Tous ont déjà livré des projets similaires au vôtre avec succès. Pas de perte de temps.
                        </p>
                    </div>
                </div>
                <div class="step">
                    <div class="body">
                        <h3>3. Vous démarrez dans les 48h</h3>
                        <p>
                            Un entretien rapide, une validation, et c'est parti. Le talent intègre votre équipe le jour J. TJM transparent, pas de surprise.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="mds-section mds-solution accent">
        <div class="mds-container">
            <div class="section-type">Notre approche</div>
            <h2 class="section-title">
                Pourquoi nos clients ne cherchent plus ailleurs après nous avoir testés ?
            </h2>
            <p>
                <strong>Parce qu'on ne vous propose que des talents qui ont déjà fait leurs preuves chez nous.</strong><br/>
                Fini les CV gonflés et les promesses en l'air. Tous nos freelances ont livré des projets concrets, mesurables, rentables.
            </p>

            <ul class="key-points">
                <li>
                    {{> "images/working"}}
                    <h3 class="font-semibold text-lg mb-2">100% de talents validés au combat</h3>
                    <p>
                        Chaque freelance a déjà livré des projets concrets avec nous. Pas de test sur votre budget : ils sont déjà rodés.
                    </p>
                </li>
                <li>
                    {{> "images/matching"}}
                    <h3 class="font-semibold text-lg mb-2">Matching ultra-précis</h3>
                    <p>
                        Pas de catalogue de 500 profils. On vous sélectionne 2-3 talents maximum, parfaitement adaptés à VOTRE projet.
                    </p>
                </li>
                <li>
                    {{> "images/productive"}}
                    <h3 class="font-semibold text-lg mb-2">Opérationnels en 24h</h3>
                    <p>
                        Nos talents connaissent nos méthodes, s'adaptent vite à vos outils. Productifs dès le premier jour, pas dans 2 semaines.
                    </p>
                </li>
            </ul>

            <p>
                <strong>Résultat : vous gagnez 3 semaines sur votre planning</strong> et évitez les mauvaises surprises à 5000€.
            </p>
            <p>
                <strong>TJM transparent, pas de commission cachée, résultats mesurables.</strong>
            </p>
            <p>
                <a href="{{@custom.global_cta_url}}" class="button primary">
                    Avoir mon talent en 48h
                </a>
            </p>
        </div>
    </section>

    <section class="faq-section mds-section">
        <div class="mds-container">
            <div class="section-type">FAQ</div>
            <h2 class="section-title">
                Questions fréquentes sur l'offre MindsersIT Talent
            </h2>

            <div class="faq-items">
                <div class="faq-item">
                    <input type="checkbox" id="faq1" class="faq-toggle" />
                    <h3><label for="faq1">Est-ce que je peux choisir le ou les freelances ?</label></h3>
                    <p>Absolument. On vous présente 1 à 3 profils que l'on recommande spécifiquement pour votre projet. Vous échangez avec eux avant de valider votre choix.</p>
                </div>

                <div class="faq-item">
                    <input type="checkbox" id="faq2" class="faq-toggle" />
                    <h3><label for="faq2">Est-ce que je peux embaucher un freelance à la fin de la mission ?</label></h3>
                    <p>Bien sûr ! Pas de problème de notre côté. C'est surtout à discuter avec le freelance car l'embauche n'est pas souvent dans leur plan de carrière.</p>
                </div>

                <div class="faq-item">
                    <input type="checkbox" id="faq3" class="faq-toggle" />
                    <h3><label for="faq3">Comment ça marche niveau facturation ?</label></h3>
                    <p>On s'adapte à vos préférences : facturation directe avec le freelance, ou via MindsersIT si c'est plus simple pour votre compta.</p>
                </div>

                <div class="faq-item">
                    <input type="checkbox" id="faq4" class="faq-toggle" />
                    <h3><label for="faq4">Y a-t-il une durée minimale d'engagement ?</label></h3>
                    <p>Aucune ! Nos clients font appel à nous pour des missions de 3 jours comme de 6 mois. Vous restez maître de votre planning.</p>
                </div>

                <div class="faq-item">
                    <input type="checkbox" id="faq5" class="faq-toggle" />
                    <h3><label for="faq5">J'ai un besoin urgent pour demain, c'est possible ?</label></h3>
                    <p>Dans la plupart des cas, oui ! Nos talents font partie de notre réseau actif, on connaît leurs disponibilités en temps réel.</p>
                </div>
                <div class="faq-item">
                    <input type="checkbox" id="faq6" class="faq-toggle" />
                    <h3><label for="faq6">Et si personne n'est disponible immédiatement ?</label></h3>
                    <p>
                        On vous le dit franchement dès le premier contact. Plutôt que de vous faire perdre du temps, on vous propose une alternative ou on planifie pour la semaine suivante.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <section class="mds-cta-end">
        {{#if @custom.global_cta_url}}
        <div class="mds-cta">
            <h2>Prêt à arrêter de perdre du temps avec des freelances décevants ?</h2>
            <p>
                Accédez dès maintenant à notre réseau de talents confirmés.<br />
                <strong>Premier profil recommandé sous 48h ou remboursé.</strong>
            </p>
            <p>
                <a href="{{@custom.global_cta_url}}" class="button highlighted">{{@custom.global_cta_text}}</a>
            </p>
            <p class='rate'>
                <span class='stars'>&starf;&starf;&starf;&starf;&starf;</span>
                <span>
                    +{{@custom.amount_of_freelancers_recommended }} missions réussies avec nos talents freelance.
                </span>
            </p>
        </div>
        {{/if}}
    </section>
</div>