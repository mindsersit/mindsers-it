{
  "name": "mindsers-monorepo",
  "private": true,
  "description": "Themes for mindsers.it (Ghost) and shop.mindsers.it (Shopify), sharing one design system",
  "scripts": {
    "build": "pnpm -r build",
    "dev:ghost": "pnpm --filter mindsers-it dev",
    "dev:shop": "pnpm --filter @mindsers/shopify-theme dev",
    "shop:pull": "pnpm --filter @mindsers/shopify-theme pull",
    "lint": "biome ci .",
    "test": "pnpm -r test",
    "test:scripts": "node --test scripts/*.test.mjs",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:tag": "node scripts/release.mjs tag"
  },
  "author": {
    "name": "Nathanaël CHERRIER",
    "email": "nathanael@mindsers.it"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.5"
  },
  "packageManager": "pnpm@10.34.7"
}
