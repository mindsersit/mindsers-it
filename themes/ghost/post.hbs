{{!< default}}

{{#contentFor 'styles'}}
<link rel="stylesheet" type="text/css" href="{{asset "css/pages.css"}}" />
{{/contentFor}}

{{#contentFor 'title'}}{{meta_title}}{{/contentFor}}

{{#post}}
{{!-- No blog: routes.yaml gives posts no URL. Kept because Ghost requires
      the template; styled like a page. --}}
<div class="mds-page">
    <div class="mds-canvas">
        <h1>{{title}}</h1>
        <div class="mds-content">
            {{content}}
        </div>
    </div>
</div>
{{/post}}
