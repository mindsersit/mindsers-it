{{!-- The hero's button and counter. With `href`, the button links there and
      `cta_label` is required. Without it, the button links to global_cta_url,
      labelled `cta_label` or global_cta_text, and shows only when the site
      has a call to action. Params: href, cta_label, counter, counter_label. --}}
<div class="mds-cta">
    {{#if href}}
    <p>
        <a href="{{href}}" class="button primary">{{cta_label}}</a>
    </p>
    {{else if @custom.global_cta_url}}
    <p>
        <a href="{{@custom.global_cta_url}}" class="button primary">{{#if cta_label}}{{cta_label}}{{else}}{{@custom.global_cta_text}}{{/if}}</a>
    </p>
    {{/if}}
    {{> "ui/rate" counter=counter counter_label=counter_label}}
</div>