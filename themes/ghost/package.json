{
  "name": "mindsers-it",
  "version": "2.1.0",
  "description": "Theme for MindsersIT website",
  "keywords": ["ghost-theme"],
  "scripts": {
    "dev": "gulp",
    "build": "gulp zip",
    "build:prod": "gulp build",
    "build:zip": "gulp zip",
    "test": "gscan .",
    "test:ci": "gscan --fatal --verbose ."
  },
  "author": {
    "name": "Nathanaël CHERRIER",
    "email": "nathanael@mindsers.it"
  },
  "private": true,
  "engines": {
    "ghost": ">=1.0.0"
  },
  "config": {
    "posts_per_page": 10,
    "image_sizes": {
      "xxs": {
        "width": 30
      },
      "xs": {
        "width": 100
      },
      "s": {
        "width": 300
      },
      "m": {
        "width": 600
      },
      "l": {
        "width": 1000
      },
      "xl": {
        "width": 2000
      }
    },
    "custom": {
      "enable_search": {
        "type": "boolean",
        "default": true
      },
      "global_cta_url": {
        "type": "text"
      },
      "global_cta_text": {
        "type": "text",
        "default": "Book a call!"
      },
      "menu_position": {
        "type": "select",
        "options": [
          "Menu centered",
          "Menu on the left side",
          "Menu on the right side"
        ],
        "default": "Menu on the left side"
      },
      "shop_url": {
        "type": "text",
        "default": "https://shop.mindsers.it/"
      },
      "talent_accent_color": {
        "type": "color",
        "default": "#9b694b",
        "group": "homepage"
      },
      "shopify_accent_color": {
        "type": "color",
        "default": "#36f4a4",
        "group": "homepage"
      },
      "price_of_mvp": {
        "type": "text",
        "default": "15000",
        "group": "homepage"
      },
      "amount_of_project_done": {
        "type": "text",
        "default": "5",
        "group": "homepage"
      },
      "price_of_landing_page": {
        "type": "text",
        "default": "3000",
        "group": "homepage"
      },
      "amount_of_landing_pages_done": {
        "type": "text",
        "default": "15",
        "group": "homepage"
      },
      "amount_of_freelancers_recommended": {
        "type": "text",
        "default": "3",
        "group": "homepage"
      },
      "amount_of_ecommerce_websites_done": {
        "type": "text",
        "default": "4",
        "group": "homepage"
      }
    },
    "card_assets": true
  },
  "devDependencies": {
    "autoprefixer": "10.6.1",
    "cssnano": "7.0.6",
    "gscan": "4.47.0",
    "gulp": "5.0.1",
    "gulp-livereload": "4.0.2",
    "gulp-postcss": "10.0.0",
    "gulp-sass": "^6.0.1",
    "gulp-sourcemaps": "3.0.0",
    "gulp-uglify": "3.0.2",
    "gulp-watch": "5.0.1",
    "gulp-zip": "6.1.0",
    "postcss": "8.5.31",
    "postcss-color-mod-function": "4.1.1",
    "postcss-easy-import": "4.0.0",
    "pump": "3.0.4",
    "sass": "^1.106.0",
    "shiki": "^4.5.0"
  }
}
