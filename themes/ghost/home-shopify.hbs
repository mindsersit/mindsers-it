{{!< default}}
{{#contentFor 'activityClass'}}mds-shopify{{/contentFor}}

{{#contentFor 'styles'}}
<link rel="stylesheet" type="text/css" href="{{asset "css/home.css"}}" />
{{/contentFor}}

{{#contentFor 'title'}}{{meta_title}} - Experts Shopify : votre e-commerce conçu pour performer{{/contentFor}}

<div class="mds-home">
    <header class="mds-header">
        <div class="mds-container">
            <div class="presentation">
                <h1 class="mds-title">Votre e-commerce Shopify, conçu par des experts qui savent ce qui vend.</h1>
                <p>
                    De la boutique clé en main à l'architecture enterprise headless : on conçoit, développe et optimise votre e-commerce Shopify pour maximiser vos ventes.
                </p>

                {{> "ui/hero-cta"
                    href="#offres"
                    cta_label="Découvrir nos solutions"
                    counter=@custom.amount_of_ecommerce_websites_done
                    counter_label="boutiques e-commerce réalisées !"}}

                <div class="offer-links">
                    <a href="/agence-shopify/basic/" class="offer-link">→ Boutique basique (4-7k€)</a>
                    <a href="/agence-shopify/personnalise/" class="offer-link">→ Solution personnalisée (8-30k€)</a>
                    <a href="/agence-shopify/enterprise/" class="offer-link">→ Architecture enterprise (30-100k€)</a>
                </div>
            </div>
        </div>
    </header>

    {{> "ui/customer-logos"}}

    <section class="mds-section mds-personas accent">
        <div class="mds-container">
            <div class="section-type">Pour qui ?</div>
            <h2 class="section-title">
                Que vous lanciez votre première boutique<br />
                ou que vous souhaitiez scaler votre e-commerce.
            </h2>

            <div class="persona-cards">
                {{> "ui/offer-card"
                    heading="Je lance ma première boutique e-commerce"
                    intro="Vous avez des produits à vendre et voulez démarrer rapidement avec une boutique professionnelle ? On crée votre site Shopify opérationnel en quelques semaines."
                    href="/agence-shopify/basic/"
                    cta_label="Voir l'offre Basique"}}

                {{> "ui/offer-card"
                    heading="Je veux personnaliser et optimiser ma boutique"
                    intro="Votre business décolle et vous avez besoin de fonctionnalités spécifiques ? On développe des solutions sur-mesure adaptées à vos processus."
                    href="/agence-shopify/personnalise/"
                    cta_label="Voir l'offre Personnalisée"}}

                {{> "ui/offer-card"
                    heading="J'ai besoin d'une architecture enterprise"
                    intro="Vous gérez un volume important et souhaitez intégrer ERP, logistique, ou passer en headless ? On conçoit l'infrastructure qui scale."
                    href="/agence-shopify/enterprise/"
                    cta_label="Voir l'offre Enterprise"}}
            </div>
        </div>
    </section>

    <section id="offres" class="mds-section offer-section">
        <div class="mds-container">
            <div class="section-type">Nos solutions</div>
            <h2 class="section-title">
                Trois niveaux d'expertise Shopify pour trois objectifs business
            </h2>
            <p>Pas sûr de la solution qu'il vous faut ? Si vous démarrez, partez sur l'offre basique. Si vous avez des besoins spécifiques, optez pour du personnalisé. Et si vous visez l'international et les gros volumes, l'architecture enterprise est faite pour vous.</p>
            <div class="pricing-options">
                <div class="pricing-option">
                    <div class="body">
                        <h3>Boutique Basique</h3>
                        <p>Site e-commerce Shopify clé en main avec thème personnalisé, paiements configurés et produits intégrés. Parfait pour démarrer.</p>
                        <p class="price">4 000€ - 7 000€</p>
                    </div>
                    <a href="/agence-shopify/basic/" class="button primary">Voir en détail</a>
                </div>
                <div class="pricing-option">
                    <div class="body">
                        <h3>Solution Personnalisée</h3>
                        <p>Développement sur-mesure avec fonctionnalités spécifiques, multilingue, et intégrations tierces adaptées à votre business.</p>
                        <p class="price">8 000€ - 30 000€</p>
                    </div>
                    <a href="/agence-shopify/personnalise/" class="button primary">Voir en détail</a>
                </div>
                <div class="pricing-option">
                    <div class="body">
                        <h3>Architecture Enterprise</h3>
                        <p>Solution complète avec ERP, logistique, architecture headless, multimarket et performance optimisée pour les gros volumes.</p>
                        <p class="price">30 000€ - 100 000€</p>
                    </div>
                    <a href="/agence-shopify/enterprise/" class="button primary">Voir en détail</a>
                </div>
            </div>
            {{#if @custom.global_cta_url}}
            <p>Vous ne trouvez pas la solution qui vous correspond ? <a href="{{@custom.global_cta_url}}">Contactez-nous</a> pour un devis personnalisé adapté à votre projet e-commerce.</p>
            {{/if}}
        </div>
    </section>

    {{> "ui/method" activity="shopify"}}

    {{> "ui/testimonial"}}

    {{> "ui/team"}}

    <section class="faq-section mds-section">
        <div class="mds-container">
            <div class="section-type">FAQ</div>
            <h2 class="section-title">
                Questions fréquentes sur nos solutions Shopify
            </h2>

            <div class="faq-items">
                <details class="faq-item">
                    <summary><h3>Pourquoi choisir Shopify plutôt qu'une autre solution e-commerce ?</h3></summary>
                    <p>Shopify combine simplicité d'utilisation, robustesse technique et écosystème riche. C'est la plateforme qui grandit avec votre business, du premier euro aux millions de chiffre d'affaires, avec des fonctionnalités natives pour l'international.</p>
                </details>

                <details class="faq-item">
                    <summary><h3>Combien de temps faut-il pour lancer ma boutique ?</h3></summary>
                    <p>Cela dépend de la complexité : 2-4 semaines pour une boutique basique, 1-3 mois pour du personnalisé, 3-6 mois pour de l'enterprise. On travaille en mode agile pour livrer une première version rapidement.</p>
                </details>

                <details class="faq-item">
                    <summary><h3>Proposez-vous la maintenance et le support après livraison ?</h3></summary>
                    <p>Oui ! On propose deux formules : Maintenance basique (100€/mois) pour les mises à jour et bugs, et Support technique (1 100-1 500€/mois) pour 15h d'accompagnement mensuel et optimisations continues.</p>
                </details>

                <details class="faq-item">
                    <summary><h3>Pouvez-vous migrer ma boutique existante vers Shopify ?</h3></summary>
                    <p>Absolument. On gère la migration complète de votre catalogue, clients, commandes et SEO depuis n'importe quelle plateforme (WooCommerce, Prestashop, Magento, etc.) avec zéro interruption de service.</p>
                </details>

                <details class="faq-item">
                    <summary><h3>Est-ce que vous gérez aussi le marketing et l'acquisition ?</h3></summary>
                    <p>Notre expertise se concentre sur la partie technique et UX de votre e-commerce. Pour le marketing, on travaille en partenariat avec des spécialistes qu'on peut vous recommander.</p>
                </details>
            </div>
        </div>
    </section>

    {{> "ui/cta-end"
        heading="Prêt à lancer votre e-commerce Shopify ?"
        intro="On prend 15 minutes pour comprendre votre projet<br /> et vous orienter vers la bonne solution."
        counter=@custom.amount_of_ecommerce_websites_done
        counter_label="e-commerces Shopify réalisés avec succès !"}}
</div>