{%- comment -%}
  Mirrors themes/ghost/default.hbs. The shared markup is described in
  packages/design-system/MARKUP.md: change both themes together.
{%- endcomment -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'head' %}

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }}">
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    <div class="mds-viewport">
      {% sections 'header-group' %}

      <main class="mds-main" id="MainContent">
        {{ content_for_layout }}
      </main>

      {% sections 'footer-group' %}
    </div>

    {% render 'search-dialog' %}

    {%- if settings.cart_type == 'drawer' -%}
      <dialog id="CartDrawer" class="mds-dialog cart-drawer" aria-labelledby="CartDrawerTitle">
        {% section 'cart-drawer' %}
      </dialog>
    {%- endif -%}

    {%- # modules, no async: they rely on the document being parsed -%}
    <script type="module" src="{{ 'menu.js' | asset_url }}"></script>
    <script type="module" src="{{ 'search.js' | asset_url }}"></script>
    {%- if settings.cart_type == 'drawer' -%}
      <script type="module" src="{{ 'cart.js' | asset_url }}"></script>
    {%- endif -%}
  </body>
</html>
