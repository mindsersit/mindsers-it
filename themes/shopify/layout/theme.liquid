{%- comment -%}
  Mirrors themes/ghost/default.hbs. The shared markup is described in
  packages/design-system/MARKUP.md: change both themes together.
{%- endcomment -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'meta-tags' %}

    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {% style %}
      :root {
        --ghost-accent-color: {{ settings.accent_color }};
      }
    {% endstyle %}

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }}">
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    <div class="mds-viewport">
      {% sections 'header-group' %}

      <main class="mds-main" id="MainContent">
        {{ content_for_layout }}
      </main>

      {% sections 'footer-group' %}
    </div>

    {%- # module, no async: menu.js relies on the document being parsed -%}
    <script type="module" src="{{ 'menu.js' | asset_url }}"></script>
  </body>
</html>
