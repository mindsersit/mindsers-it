<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'meta-tags' %}

    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {% style %}
      :root {
        --ghost-accent-color: {{ settings.accent_color }};
      }
    {% endstyle %}

    {{ content_for_header }}
  </head>

  <body class="template-password">
    <main class="mds-main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
