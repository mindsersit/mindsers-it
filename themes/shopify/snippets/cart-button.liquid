{%- doc -%}
  Header cart link with the item count. Also rendered by
  sections/cart-button.liquid so cart.js can refresh it after a change.
{%- enddoc -%}
<a
  class="cart-button"
  id="CartButton"
  href="{{ routes.cart_url }}"
  aria-label="{{ 'header.cart' | t: count: cart.item_count }}"
  {% if settings.cart_type == 'drawer' %}
    aria-haspopup="dialog"
  {% endif %}
>
  {{ 'icon-cart.svg' | inline_asset_content }}
  {%- if cart.item_count > 0 -%}
    <span class="cart-count" aria-hidden="true">{{ cart.item_count }}</span>
  {%- endif -%}
</a>
