{%- doc -%}
  Product tile used by collections, search results, recommendations and the
  shop home page.

  @param {product} product - The product to show
  @param {boolean} [eager] - Load the image eagerly (cards in the first row)
{%- enddoc -%}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign loading = 'lazy'
  if eager
    assign loading = 'eager'
  endif
  assign alt = product.featured_media.alt | default: product.title
-%}
<article class="product-card">
  <a class="product-card__link" href="{{ product.url }}">
    <div class="product-card__media">
      {%- if product.featured_media -%}
        {{
          product.featured_media
          | image_url: width: 800
          | image_tag:
            widths: '300, 400, 600, 800',
            sizes: '(min-width: 1280px) 300px, (min-width: 1000px) 25vw, (min-width: 700px) 33vw, 50vw',
            loading: loading,
            alt: alt
        }}
      {%- endif -%}
    </div>
    {% render 'product-badges', variant: variant %}
    <div class="product-card__info">
      <h3 class="product-card__title">{{ product.title | escape }}</h3>
      {% render 'price', variant: variant, product: product %}
    </div>
  </a>
</article>
