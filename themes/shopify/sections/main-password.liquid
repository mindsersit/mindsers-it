<div class="mds-container mds-shop-page">
  <h1>{{ 'password.title' | t }}</h1>

  {% if shop.password_message %}
    <p>{{ shop.password_message }}</p>
  {% endif %}

  {% form 'storefront_password' %}
    {{ form.errors | default_errors }}

    <label for="PasswordInput">{{ 'password.password' | t }}</label>
    <input type="password" name="password" id="PasswordInput">

    <button type="submit" class="button primary">{{ 'password.enter' | t }}</button>
  {% endform %}
</div>

{% schema %}
{
  "name": "t:sections.main_password.name",
  "settings": []
}
{% endschema %}
