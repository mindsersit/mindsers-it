{%- comment -%}
  Foundation only: gallery, variant picker, buy buttons and app blocks come
  with the commerce features.
{%- endcomment -%}
{%- assign current_variant = product.selected_or_first_available_variant -%}

<div class="mds-container mds-shop-page">
  <div class="product-images">
    {% for image in product.images %}
      {% render 'image', class: 'product-image', image: image, width: 1000 %}
    {% endfor %}
  </div>

  <div class="product-info">
    <h1>{{ product.title }}</h1>
    <p>{{ current_variant.price | money }}</p>
    {{ product.description }}
  </div>

  <div class="product-form">
    {% form 'product', product %}
      <label for="ProductVariant-{{ section.id }}">{{ 'product.variant' | t }}</label>
      <select id="ProductVariant-{{ section.id }}" name="id">
        {% for variant in product.variants %}
          <option
            value="{{ variant.id }}"
            {% if variant == current_variant %}
              selected
            {% endif %}
            {% unless variant.available %}
              disabled
            {% endunless %}
          >
            {{ variant.title }} - {{ variant.price | money }}
          </option>
        {% endfor %}
      </select>

      <label for="ProductQuantity-{{ section.id }}">{{ 'product.quantity' | t }}</label>
      <input id="ProductQuantity-{{ section.id }}" type="number" name="quantity" min="1" value="1">

      <button type="submit" class="button primary"{% unless current_variant.available %} disabled{% endunless %}>
        {%- if current_variant.available -%}
          {{ 'product.add_to_cart' | t }}
        {%- else -%}
          {{ 'product.sold_out' | t }}
        {%- endif -%}
      </button>
      {{ form | payment_button }}
    {% endform %}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_product.name",
  "settings": []
}
{% endschema %}
