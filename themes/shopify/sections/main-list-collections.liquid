<div class="mds-container mds-shop-page">
  <h1>{{ 'collections.title' | t }}</h1>

  <ul class="product-grid">
    {%- for collection in collections -%}
      <li>
        <article class="product-card">
          <a class="product-card__link" href="{{ collection.url }}">
            <div class="product-card__media">
              {%- assign image = collection.featured_image | default: collection.products.first.featured_media -%}
              {%- if image -%}
                {{
                  image
                  | image_url: width: 800
                  | image_tag: widths: '300, 400, 600, 800', sizes: '(min-width: 1100px) 300px, 50vw', loading: 'lazy'
                }}
              {%- endif -%}
            </div>
            <div class="product-card__info">
              <h2 class="product-card__title">{{ collection.title | escape }}</h2>
            </div>
          </a>
        </article>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "t:sections.main_list_collections.name",
  "settings": []
}
{% endschema %}
