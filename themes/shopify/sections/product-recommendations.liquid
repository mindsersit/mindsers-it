{%- comment -%}
  Rendered empty on the product page, then filled by recommendations.js,
  which requests this section again from routes.product_recommendations_url.
{%- endcomment -%}
<div class="mds-container">
  <div
    class="product-recommendations"
    data-recommendations
    data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related"
  >
    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      <h2>{{ section.settings.heading | escape }}</h2>
      <ul class="product-grid">
        {%- for recommendation in recommendations.products -%}
          <li>{% render 'product-card', product: recommendation %}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

<script type="module" src="{{ 'recommendations.js' | asset_url }}"></script>

{% schema %}
{
  "name": "t:sections.product_recommendations.name",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.product_recommendations.heading",
      "default": "Vous aimerez aussi"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "t:sections.product_recommendations.limit",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [{ "name": "t:sections.product_recommendations.name" }]
}
{% endschema %}
