<div class="mds-container mds-shop-page">
  <h1>{{ 'cart.title' | t }}</h1>

  {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post">
      <table>
        {% for item in cart.items %}
          <tr>
            <td>
              {% if item.image %}
                {% render 'image', image: item.image, url: item.url, width: 150 %}
              {% endif %}
            </td>
            <td>
              <p>{{ item.product.title | link_to: item.url }}</p>
              {% unless item.product.has_only_default_variant %}
                <p>{{ item.variant.title }}</p>
              {% endunless %}
              {{ 'cart.remove' | t | link_to: item.url_to_remove }}
            </td>
            <td>
              <label for="CartQuantity-{{ forloop.index }}">{{ 'product.quantity' | t }}</label>
              <input id="CartQuantity-{{ forloop.index }}" type="number" min="0" name="updates[]" value="{{ item.quantity }}">
            </td>
            <td>{{ item.final_line_price | money }}</td>
          </tr>
        {% endfor %}
      </table>

      <p>{{ 'cart.subtotal' | t }} {{ cart.total_price | money_with_currency }}</p>

      <button type="submit" class="button">{{ 'cart.update' | t }}</button>
      <button type="submit" name="checkout" class="button primary">{{ 'cart.checkout' | t }}</button>
    </form>
  {% else %}
    <p>{{ 'cart.empty' | t }}</p>
    <a href="{{ routes.all_products_collection_url }}">{{ '404.back_to_shopping' | t }}</a>
  {% endif %}
</div>

{% schema %}
{
  "name": "t:sections.main_cart.name",
  "settings": []
}
{% endschema %}
