<div class="mds-container mds-shop-page cart-page">
  <h1>{{ 'cart.title' | t }}</h1>

  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" id="CartForm">
      <ul class="cart-items">
        {%- for item in cart.items -%}
          {% render 'cart-item', item: item, index: forloop.index %}
        {%- endfor -%}
      </ul>

      {%- if section.settings.show_note -%}
        <div class="field cart-note">
          <label for="CartNote">{{ 'cart.note' | t }}</label>
          <textarea id="CartNote" name="note">{{ cart.note | escape }}</textarea>
        </div>
      {%- endif -%}

      <div class="cart-footer">
        {% render 'cart-totals' %}
        <button type="submit" class="button full">{{ 'cart.update' | t }}</button>
        <button type="submit" name="checkout" class="button primary full">{{ 'cart.checkout' | t }}</button>
        {%- if additional_checkout_buttons -%}
          <div class="additional-checkout-buttons">{{ content_for_additional_checkout_buttons }}</div>
        {%- endif -%}
      </div>
    </form>

    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when '@app' -%}
          {% render block %}
      {%- endcase -%}
    {%- endfor -%}
  {%- else -%}
    <p>{{ 'cart.empty' | t }}</p>
    <a class="button" href="{{ routes.all_products_collection_url }}">{{ '404.back_to_shopping' | t }}</a>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.main_cart.name",
  "blocks": [{ "type": "@app" }],
  "settings": [
    {
      "type": "checkbox",
      "id": "show_note",
      "label": "t:sections.main_cart.show_note",
      "default": false
    }
  ]
}
{% endschema %}
