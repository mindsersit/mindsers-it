<div class="mds-container mds-shop-page">
  <header class="collection-header">
    <h1>{{ collection.title | escape }}</h1>
    {%- if collection.description != blank -%}
      <div class="collection-description">{{ collection.description }}</div>
    {%- endif -%}
  </header>

  {% paginate collection.products by section.settings.products_per_page %}
    {%- if section.settings.enable_filters -%}
      {% render 'facets', results: collection %}
    {%- endif -%}

    {%- if collection.products.size > 0 -%}
      <ul class="product-grid">
        {%- for product in collection.products -%}
          <li>
            {%- liquid
              assign eager = false
              if forloop.index <= 4
                assign eager = true
              endif
              render 'product-card', product: product, eager: eager
            -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p>{{ 'collections.empty' | t }}</p>
    {%- endif -%}

    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="{{ 'collections.pagination' | t }}">
        {{ paginate | default_pagination }}
      </nav>
    {%- endif -%}
  {% endpaginate %}
</div>

<script type="module" src="{{ 'facets.js' | asset_url }}"></script>

{% schema %}
{
  "name": "t:sections.main_collection.name",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:sections.main_collection.products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "enable_filters",
      "label": "t:sections.main_collection.enable_filters",
      "default": true
    }
  ]
}
{% endschema %}
